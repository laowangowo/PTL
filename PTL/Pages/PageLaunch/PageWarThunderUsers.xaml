<local:MyPageRight x:Class="PageWarThunderUsers"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PTL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,25,25,10">
            <local:MyCard Title="切换玩家">
                <StackPanel Margin="25,38,23,16">
                    <TextBlock Text="切换玩家会切换登录凭据和音效包、瞄具的下载位置"
                               FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock Text="每个账号都需登录一次，之后会保存登录凭据，切换玩家时无需再次登录"
                               Margin="0,7,0,14" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                    <StackPanel x:Name="PanUsers" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <local:MyButton x:Name="BtnRefreshUsers" Text="重新扫描" Width="110" Height="34"
                                        Margin="0,0,8,0" />
                        <local:MyButton x:Name="BtnSaveCurrentAuth" Text="保存当前登录" Width="130" Height="34"
                                        Margin="0,0,8,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnOpenSaves" Text="打开存档目录" Width="130" Height="34" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
