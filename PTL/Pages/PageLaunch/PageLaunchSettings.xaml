<local:MyPageRight x:Class="PageLaunchSettings"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PTL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          x:Name="PanBack">
        <StackPanel Margin="25,25,25,10">
            <local:MyCard Title="玩家资料">
                <Grid Margin="25,38,23,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.RowSpan="2" Width="58" Height="58" CornerRadius="29"
                            Background="{DynamicResource ColorBrushSemiTransparent}"
                            BorderBrush="{DynamicResource ColorBrushGray2}" BorderThickness="1"
                            VerticalAlignment="Top">
                        <local:MyImage x:Name="ImgSettingsAvatar" Width="56" Height="56" Stretch="UniformToFill">
                            <local:MyImage.Clip>
                                <RectangleGeometry Rect="0,0,56,56" RadiusX="28" RadiusY="28" />
                            </local:MyImage.Clip>
                        </local:MyImage>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,16,0">
                        <TextBlock x:Name="LabSettingsNickname" Text="尚未读取玩家资料" FontSize="17"
                                   FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="LabSettingsUid" Text="玩家 ID 尚未设置" Margin="0,5,0,0"
                                   FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" />
                        <TextBlock x:Name="LabPlayerStatus" Text="点击右边刷新资料按钮即可刷新"
                                   Margin="0,7,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrushGray2}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <local:MyButton x:Name="BtnRefreshPlayer" Text="刷新资料" Width="96" Height="32" Margin="0,0,8,0" />
                        <local:MyButton x:Name="BtnSwitchPlayer" Text="切换用户" Width="96" Height="32" />
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextPlayerNickname" Height="34" HintText="战雷用户名"
                                         ToolTip="留空时会自动使用 WT Live 返回的昵称。" />
                        <local:MyTextBox x:Name="TextPlayerUid" Grid.Column="2" Height="34" HintText="玩家 ID（纯数字）" />
                        <local:MyButton x:Name="BtnSavePlayer" Grid.Column="3" Text="保存玩家" Width="100" Height="34"
                                        Margin="8,0,0,0" ColorType="Highlight" />
                    </Grid>
                </Grid>
            </local:MyCard>

            <local:MyCard Title="游戏服务器" Margin="0,15,0,15">
                <Grid Margin="25,38,23,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="服务器通道" VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <local:MyComboBox x:Name="ComboServer" Grid.Column="1" Height="32">
                        <local:MyComboBoxItem Content="正式服" Tag="production" />
                        <local:MyComboBoxItem Content="测试服" Tag="dev" />
                    </local:MyComboBox>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                               Text="测试服仅在 Gaijin 开放测试时可用，切换后启动器会使用对应的更新通道和服务器。"
                               FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                </Grid>
            </local:MyCard>

            <local:MyCard Title="随雷启动" Margin="0,0,0,15">
                <StackPanel Margin="25,38,23,16">
                    <TextBlock Text="启动战争雷霆后，会同时启动下面列出的程序。关闭游戏不会自动关闭这些程序。"
                               FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                    <StackPanel x:Name="PanLaunchWithPrograms" Margin="0,12,0,0" />
                    <local:MyButton x:Name="BtnAddLaunchWithProgram"
                                    Text="添加程序" Width="110" Height="34"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="画面与声音" Margin="0,15,0,15">
                <Grid Margin="25,38,23,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="游戏画质" VerticalAlignment="Center" Margin="0,0,0,12"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <local:MyComboBox x:Name="ComboGraphicsQuality" Grid.Column="1" Height="32" Margin="0,0,0,12">
                        <local:MyComboBoxItem Content="极低" Tag="ultralow" />
                        <local:MyComboBoxItem Content="低" Tag="low" />
                        <local:MyComboBoxItem Content="中" Tag="medium" />
                        <local:MyComboBoxItem Content="高" Tag="high" />
                        <local:MyComboBoxItem Content="极高" Tag="max" />
                        <local:MyComboBoxItem Content="电影" Tag="movie" />
                        <local:MyComboBoxItem Content="自定义" Tag="custom" />
                    </local:MyComboBox>

                    <TextBlock Grid.Row="1" Text="分辨率" VerticalAlignment="Center" Margin="0,0,0,12"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <local:MyComboBox x:Name="ComboResolution" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,0,0,12">
                        <local:MyComboBoxItem Content="自动" Tag="auto" />
                        <local:MyComboBoxItem Content="1280 × 720" Tag="1280 x 720" />
                        <local:MyComboBoxItem Content="1366 × 768" Tag="1366 x 768" />
                        <local:MyComboBoxItem Content="1600 × 900" Tag="1600 x 900" />
                        <local:MyComboBoxItem Content="1920 × 1080" Tag="1920 x 1080" />
                        <local:MyComboBoxItem Content="2560 × 1440" Tag="2560 x 1440" />
                        <local:MyComboBoxItem Content="3840 × 2160" Tag="3840 x 2160" />
                    </local:MyComboBox>

                    <TextBlock Grid.Row="2" Text="窗口模式" VerticalAlignment="Center" Margin="0,0,0,12"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <local:MyComboBox x:Name="ComboWindowMode" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,0,0,12">
                        <local:MyComboBoxItem Content="无边框全屏" Tag="fullscreenwindowed" />
                        <local:MyComboBoxItem Content="独占全屏" Tag="fullscreen" />
                        <local:MyComboBoxItem Content="窗口化" Tag="windowed" />
                    </local:MyComboBox>

                    <TextBlock Grid.Row="3" Text="图形接口" VerticalAlignment="Center" Margin="0,0,0,12"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <local:MyComboBox x:Name="ComboDriver" Grid.Row="3" Grid.Column="1" Height="32" Margin="0,0,0,12">
                        <local:MyComboBoxItem Content="自动" Tag="auto" />
                        <local:MyComboBoxItem Content="DirectX 11" Tag="dx11" />
                        <local:MyComboBoxItem Content="DirectX 12" Tag="dx12" />
                    </local:MyComboBox>

                    <TextBlock Grid.Row="4" Text="垂直同步" VerticalAlignment="Center" Margin="0,0,0,8"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <local:MyCheckBox x:Name="CheckVSync" Grid.Row="4" Grid.Column="1" Height="28"
                                      Text="开启垂直同步" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="5" Text="VR 模式" VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <local:MyCheckBox x:Name="CheckVR" Grid.Row="5" Grid.Column="1" Height="28"
                                      Text="启动时开启 VR 模式" />

                    <TextBlock Grid.Row="6" Text="游戏声音" VerticalAlignment="Center" Margin="0,8,0,8"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <local:MyCheckBox x:Name="CheckSound" Grid.Row="6" Grid.Column="1" Height="28"
                                      Text="开启游戏声音" Margin="0,8,0,8" />

                    <TextBlock Grid.Row="7" Text="扬声器模式" VerticalAlignment="Center" Margin="0,0,0,12"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <local:MyComboBox x:Name="ComboSpeaker" Grid.Row="7" Grid.Column="1" Height="32" Margin="0,0,0,12">
                        <local:MyComboBoxItem Content="自动" Tag="auto" />
                        <local:MyComboBoxItem Content="立体声" Tag="stereo" />
                        <local:MyComboBoxItem Content="5.1 声道" Tag="speakers5.1" />
                        <local:MyComboBoxItem Content="7.1 声道" Tag="speakers7.1" />
                    </local:MyComboBox>
                </Grid>
            </local:MyCard>

            <local:MyCard Title="安装位置">
                <StackPanel Margin="25,38,23,16">
                    <TextBlock x:Name="LabSettingsPath" Text="尚未找到战争雷霆安装目录"
                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                    
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnChooseFolder" Text="更改安装目录" Height="35" Width="140"
                                        Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnSaveSettings" Text="保存设置" Height="35" Width="120"
                                        ColorType="Highlight" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
