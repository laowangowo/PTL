<local:MyPageLeft x:Class="PageLaunchLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PTL"
                  mc:Ignorable="d" x:Name="PanBack"
                  d:DesignHeight="417.2" Width="300">
    <Grid Name="PanInput" RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="10" />
        </Grid.ColumnDefinitions>

        <local:MyButton Grid.Row="3" Grid.Column="2" x:Name="BtnVersion"
                        Height="35" Margin="0,10,10,0" Text="启动设置" IsEnabled="False" />
        <local:MyButton Grid.Row="3" Grid.Column="3" x:Name="BtnMore"
                        Visibility="Collapsed" Height="35" Margin="0,10,10,0"
                        TextPadding="36" Text="管理组件" />

        <Grid Grid.ColumnSpan="5" Grid.Row="1" Margin="20,0" VerticalAlignment="Center"
              x:Name="PanWtPlayer" Cursor="Hand"
              MouseLeftButtonUp="PanWtPlayer_MouseLeftButtonUp">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="62" Height="62" CornerRadius="31"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource ColorBrushSemiTransparent}"
                        BorderBrush="{DynamicResource ColorBrushGray2}" BorderThickness="1">
                    <local:MyImage x:Name="ImgWtPlayerAvatar" Width="60" Height="60"
                                   Stretch="UniformToFill">
                        <local:MyImage.Clip>
                            <RectangleGeometry Rect="0,0,60,60" RadiusX="30" RadiusY="30" />
                        </local:MyImage.Clip>
                    </local:MyImage>
                </Border>
                <TextBlock x:Name="LabWtPlayerNickname" Text="正在读取玩家资料"
                           Margin="0,9,0,0" HorizontalAlignment="Center"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="LabWtPlayerUid" Text="点击切换用户"
                           Margin="0,4,0,0" HorizontalAlignment="Center"
                           FontSize="11.5" Foreground="{DynamicResource ColorBrushGray2}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Grid Grid.ColumnSpan="5" Grid.Row="2" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="AprilScaleTrans" />
                    <TranslateTransform x:Name="AprilPosTrans" />
                </TransformGroup>
            </Grid.RenderTransform>
            <local:MyButton x:Name="BtnLaunch" Height="54" Margin="20,0"
                            Text="正在查找战争雷霆" ColorType="Highlight"
                            Padding="30,0,30,15" IsEnabled="False" />
            <TextBlock x:Name="LabVersion" Text="正在检测安装目录，请稍候"
                       Margin="35,0,35,10" IsHitTestVisible="False"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" FontSize="11"
                       Foreground="{DynamicResource ColorBrushGray3}"
                       RenderTransformOrigin="0.5,-0.2">
                <TextBlock.RenderTransform>
                    <ScaleTransform
                        ScaleX="{Binding RealRenderTransform.ScaleX, ElementName=BtnLaunch, Mode=OneWay}"
                        ScaleY="{Binding RealRenderTransform.ScaleY, ElementName=BtnLaunch, Mode=OneWay}" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
    </Grid>
</local:MyPageLeft>
