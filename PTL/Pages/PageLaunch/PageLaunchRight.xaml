<local:MyPageRight x:Class="PageLaunchRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PTL"
                   PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10"
                    Visibility="Visible">
            <local:MyCard x:Name="CardWtNews" Title="最新新闻"
                          HasMouseAnimation="False">
                <StackPanel Margin="25,38,23,16">
                    <TextBlock x:Name="LabWtNewsStatus"
                               Text="正在获取官方新闻…"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                    <StackPanel x:Name="PanWtNews"
                                Margin="0,10,0,0" />
                    <local:MyButton x:Name="BtnWtNewsRefresh"
                                    Text="刷新新闻"
                                    Width="92"
                                    Height="32"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Right" />
                </StackPanel>
            </local:MyCard>
            <local:MyTextBox x:Name="LabLog" Visibility="Collapsed" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
