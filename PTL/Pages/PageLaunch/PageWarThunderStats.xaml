<local:MyPageRight x:Class="PageWarThunderStats"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PTL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          x:Name="PanBack">
        <StackPanel Margin="25,25,25,10">
            <local:MyCard Title="玩家战绩">
                <StackPanel>
                    <Grid Margin="25,38,23,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" CornerRadius="32"
                                Background="{DynamicResource ColorBrushSemiTransparent}"
                                BorderBrush="{DynamicResource ColorBrushGray2}" BorderThickness="1">
                            <local:MyImage x:Name="ImgStatsAvatar" Width="62" Height="62" Stretch="UniformToFill">
                                <local:MyImage.Clip>
                                    <RectangleGeometry Rect="0,0,62,62" RadiusX="31" RadiusY="31" />
                                </local:MyImage.Clip>
                            </local:MyImage>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="LabStatsNickname" Text="正在读取玩家资料" FontSize="19"
                                       FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" />
                            <TextBlock x:Name="LabStatsUid" Text="UID 尚未识别" Margin="0,5,0,0"
                                       FontSize="12" Foreground="{DynamicResource ColorBrushGray2}" />
                            <TextBlock x:Name="LabStatsStatus" Text="正在获取玩家战绩…" Margin="0,7,0,0"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush3}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <local:MyButton x:Name="BtnStatsRefresh" Text="刷新战绩" Width="104" Height="35"
                                            Margin="0,0,8,0" ColorType="Highlight" />
                            <local:MyButton x:Name="BtnStatsWeb" Text="官方资料页" Width="110" Height="35" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="25,0,23,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextStatsQuery" Height="34"
                                         HintText="输入玩家 UID 或昵称" />
                        <local:MyButton x:Name="BtnStatsQuery" Grid.Column="1" Text="查询玩家"
                                        Width="108" Height="34" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="战绩摘要" Margin="0,15,0,15">
                <Grid Margin="25,38,23,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="玩家等级" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabStatsLevel" Grid.Column="1" Text="—" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="总场次" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabStatsBattles" Grid.Column="3" Text="—" VerticalAlignment="Center" FontWeight="SemiBold" />

                    <TextBlock Grid.Row="1" Text="胜率" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabStatsWinRate" Grid.Row="1" Grid.Column="1" Text="—" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="胜利场次" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabStatsVictories" Grid.Row="1" Grid.Column="3" Text="—" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="2" Text="死亡次数" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabStatsDeaths" Grid.Row="2" Grid.Column="1" Text="—" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="总击毁" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabStatsKills" Grid.Row="2" Grid.Column="3" Text="—" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="3" Text="空战击毁" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabStatsAirKills" Grid.Row="3" Grid.Column="1" Text="—" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="陆战击毁" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabStatsGroundKills" Grid.Row="3" Grid.Column="3" Text="—" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="4" Text="海战击毁" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabStatsNavalKills" Grid.Row="4" Grid.Column="1" Text="—" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="游戏时长" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabStatsPlayTime" Grid.Row="4" Grid.Column="3" Text="—" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="5" Text="KD" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabStatsKD" Grid.Row="5" Grid.Column="1" Text="—" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="联队" Foreground="{DynamicResource ColorBrushGray2}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LabStatsClan" Grid.Row="5" Grid.Column="3" Text="—" VerticalAlignment="Center" />
                </Grid>
            </local:MyCard>

            <local:MyCard Title="模式战绩" Margin="0,15,0,15">
                <StackPanel x:Name="PanModes" Margin="25,38,23,16">
                    <TextBlock Text="查询后可查看街机、历史与全真模式数据。" FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
