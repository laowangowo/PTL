<local:MyPageRight x:Class="PageWarThunderTools"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PTL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          x:Name="PanBack">
        <StackPanel Margin="25,25,25,10">
            <local:MyCard Title="工具下载">
                <StackPanel Margin="25,38,23,16">
                    <TextBlock Text="这里提供适用于 PTL 和战争雷霆的辅助工具。点击安装后会自动下载最新版本，并在后台完成安装。"
                               FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnToolsRefresh" Text="刷新工具列表" Width="125" Height="35"
                                        Margin="0,0,8,0" ColorType="Highlight" />
                    </StackPanel>
                    <TextBlock x:Name="LabToolsStatus" Text="正在获取工具列表…" Margin="0,13,0,0"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="可安装工具" Margin="0,15,0,15">
                <StackPanel x:Name="PanTools" Margin="25,38,23,16" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
