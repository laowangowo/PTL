<local:MyPageRight x:Class="PageWarThunderResources"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PTL"
                   PanScroll="PanBack">
    <local:MyScrollViewer x:Name="PanBack"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25">
            <local:MyCard x:Name="CardSearch" Title="搜索瞄具" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="35" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="标签" VerticalAlignment="Center" Margin="0,0,15,0" />
                        <local:MyTextBox x:Name="TextSearchTags" Grid.Column="1"
                                         HintText="例如 #anime #modern" />

                        <TextBlock Text="排序" Grid.Column="3" VerticalAlignment="Center"
                                   Margin="0,0,15,0" />
                        <local:MyComboBox x:Name="ComboSort" Grid.Column="4">
                            <local:MyComboBoxItem Content="最新发布" Tag="created" IsSelected="True" />
                            <local:MyComboBoxItem Content="最多下载" Tag="downloads" />
                            <local:MyComboBoxItem Content="最高评分" Tag="rating" />
                            <local:MyComboBoxItem Content="最多评论" Tag="comments" />
                        </local:MyComboBox>

                        <TextBlock Text="时间" Grid.Column="6" VerticalAlignment="Center"
                                   Margin="0,0,15,0" />
                        <local:MyComboBox x:Name="ComboPeriod" Grid.Column="7">
                            <local:MyComboBoxItem Content="全部时间" Tag="0" IsSelected="True" />
                            <local:MyComboBoxItem Content="最近一天" Tag="1" />
                            <local:MyComboBoxItem Content="最近一周" Tag="7" />
                            <local:MyComboBoxItem Content="最近一月" Tag="30" />
                            <local:MyComboBoxItem Content="最近一年" Tag="365" />
                        </local:MyComboBox>

                        <TextBlock Text="安装到" Grid.Row="2" VerticalAlignment="Center"
                                   Margin="0,0,15,0" />
                        <TextBlock x:Name="LabDestination" Grid.Row="2" Grid.Column="1"
                                   Grid.ColumnSpan="7" VerticalAlignment="Center"
                                   FontFamily="Consolas" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ColorBrushGray2}" />
                    </Grid>

                    <Grid Margin="0,8,0,4" Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnSearch" Text="搜索" MinWidth="140"
                                        Padding="13,0" Margin="0,0,14,0"
                                        ColorType="Highlight" />
                        <local:MyButton x:Name="BtnReset" Text="重置条件" MinWidth="120"
                                        Padding="13,0" Margin="0,0,14,0" Grid.Column="1" />
                        <local:MyButton x:Name="BtnChooseResource" Text="安装本地文件"
                                        MinWidth="130" Padding="13,0" Margin="0,0,14,0"
                                        Grid.Column="2" />
                        <local:MyButton x:Name="BtnOpenResourceFolder" Text="打开安装目录"
                                        MinWidth="130" Padding="13,0" Grid.Column="3" />
                    </Grid>
                    <local:MyCheckBox x:Name="CheckUseLoops"
                                      Text="循环枪声兼容模式"
                                      HorizontalAlignment="Left" Margin="0,9,0,0" />
                    <TextBlock x:Name="LabSearchHelp" Margin="0,7,0,0" FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                </StackPanel>
            </local:MyCard>

            <StackPanel x:Name="PanContent">
                <local:MyHint x:Name="HintError" HasBorder="True" Theme="Yellow"
                              Margin="0,0,0,15" Visibility="Collapsed" />
                <Border x:Name="CardProjects" MinHeight="80" CornerRadius="5"
                        Background="#F7FFFFFF" BorderBrush="{DynamicResource ColorBrushGray1}"
                        BorderThickness="1">
                    <StackPanel x:Name="PanProjects" Margin="8" MinHeight="64" />
                </Border>
                <Border x:Name="CardPages" Margin="0,15,0,0"
                        HorizontalAlignment="Center" MinHeight="39"
                        Padding="10,7" CornerRadius="5"
                        Background="#F7FFFFFF"
                        BorderBrush="{DynamicResource ColorBrushGray1}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Height="23">
                        <local:MyIconButton x:Name="BtnPageFirst" IsEnabled="False"
                                            Opacity="0.2" Margin="0,0.5,5,0.5"
                                            Logo="M496.213333 329.856L315.306667 510.848l180.992 181.077333a42.666667 42.666667 0 1 1-60.330667 60.330667l-211.2-211.2a42.453333 42.453333 0 0 1-11.818667-22.613333l-0.597333-5.034667v-5.034667a42.496 42.496 0 0 1 12.373333-27.648l211.2-211.2a42.666667 42.666667 0 0 1 60.373334 60.330667z m298.666667 0l-180.949333 180.992 180.992 181.077333a42.666667 42.666667 0 1 1-60.330667 60.330667l-211.2-211.2a42.453333 42.453333 0 0 1-11.818667-22.613333l-0.597333-5.034667v-5.034667a42.496 42.496 0 0 1 12.373333-27.648l211.2-211.2a42.666667 42.666667 0 0 1 60.373334 60.330667z" />
                        <local:MyIconButton x:Name="BtnPageLeft" IsEnabled="False"
                                            Opacity="0.2" Margin="0,0,5,0"
                                            Logo="M650.752 278.357333l-241.322667 241.365334 241.322667 241.365333a42.666667 42.666667 0 1 1-60.330667 60.330667l-271.530666-271.530667a42.453333 42.453333 0 0 1-11.818667-22.613333l-0.597333-5.034667v-5.034667a42.496 42.496 0 0 1 12.416-27.648l271.530666-271.530666a42.666667 42.666667 0 0 1 60.330667 60.330666z" />
                        <TextBlock x:Name="LabPage" Text="1" Margin="8,0,13,0"
                                   FontSize="15" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ColorBrush3}" />
                        <local:MyIconButton x:Name="BtnPageRight" Margin="0,0,30,0"
                                            Logo="M404.309333 278.357333l241.322667 241.365334-241.322667 241.365333a42.666667 42.666667 0 1 0 60.330667 60.330667l271.530667-271.530667a42.453333 42.453333 0 0 0 11.818666-22.613333l0.597334-5.034667v-5.034667a42.496 42.496 0 0 0-12.416-27.648L464.64 218.026667a42.666667 42.666667 0 0 0-60.330667 60.330666z" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <local:MyCard HorizontalAlignment="Center" SnapsToDevicePixels="True"
                          x:Name="PanLoad" UseAnimation="False" Margin="40,50">
                <local:MyLoading Text="正在获取资源列表" Margin="20,20,20,17"
                                 x:Name="Load" HorizontalAlignment="Center"
                                 VerticalAlignment="Center" ShowProgress="True" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
