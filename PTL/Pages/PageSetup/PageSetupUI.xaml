<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PTL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageSetupUI"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard x:Name="CardWarThunderPlayer" Margin="0,15,0,0" Title="战争雷霆玩家">
                <Grid Margin="25,38,23,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="26"
                            Background="{DynamicResource ColorBrushSemiTransparent}"
                            BorderBrush="{DynamicResource ColorBrushGray2}" BorderThickness="1">
                        <local:MyImage x:Name="ImgSetupWtAvatar" Width="50" Height="50"
                                       Stretch="UniformToFill">
                            <local:MyImage.Clip>
                                <RectangleGeometry Rect="0,0,50,50" RadiusX="25" RadiusY="25" />
                            </local:MyImage.Clip>
                        </local:MyImage>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="LabSetupWtNickname" Text="正在读取战争雷霆玩家"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ColorBrush1}" />
                        <TextBlock x:Name="LabSetupWtUid" Text="设置玩家 ID、昵称、画质与声音"
                                   Margin="0,4,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource ColorBrushGray2}" />
                    </StackPanel>
                    <local:MyButton x:Name="BtnSetupWtOpen" Grid.Column="2"
                                    Text="玩家与启动设置" Width="140" Height="35"
                                    VerticalAlignment="Center" ColorType="Highlight" />
                </Grid>
            </local:MyCard>

            <local:MyCard Margin="0,15" Title="PTL 主题" x:Name="CardLauncher">
                <StackPanel Margin="25,40,25,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="不透明度" Margin="0,0,20,0" />
                        <local:MySlider local:SettingService.Key="UiLauncherTransparent"
                                        MaxValue="600" ValueByKey="10"
                                        x:Name="SliderLauncherTransparent" Grid.Column="1" />
                    </Grid>
                    <Grid Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="主题颜色" Margin="0,0,0,12" FontWeight="SemiBold" />
                            <WrapPanel>
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme"
                                                  local:SettingService.Value="0"
                                                  Text="PTL蓝" x:Name="RadioLauncherTheme0"
                                                  Margin="0,0,20,12" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme"
                                                  local:SettingService.Value="1"
                                                  Text="PTL青" x:Name="RadioLauncherTheme1"
                                                  Margin="0,0,20,12" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme"
                                                  local:SettingService.Value="2"
                                                  Text="PTL绿" x:Name="RadioLauncherTheme2"
                                                  Margin="0,0,20,12" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme"
                                                  local:SettingService.Value="3"
                                                  Text="PTL黄" x:Name="RadioLauncherTheme3"
                                                  Margin="0,0,20,12" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme"
                                                  local:SettingService.Value="4"
                                                  Text="PTL棕" x:Name="RadioLauncherTheme4"
                                                  Margin="0,0,20,12" />
                            </WrapPanel>
                        </StackPanel>
                        <Border x:Name="PanThemeLock"
                                Background="#EAF3FAFF"
                                BorderBrush="{DynamicResource ColorBrushGray1}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="18,14">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="激活后解锁主题颜色" FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource ColorBrush1}" />
                                <TextBlock Text="激活 PTL即可切换主题颜色。"
                                           Margin="0,6,0,10" FontSize="11.5"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ColorBrushGray2}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <local:MyButton x:Name="BtnActivateForTheme"
                                                    Text="前往激活" Width="120" Height="34"
                                                    Margin="0,0,8,0" ColorType="Highlight" />
                                    <local:MyButton x:Name="BtnSupportPtl"
                                                    Text="支持开发" Width="120" Height="34" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardBackground" Margin="0,0,0,15" Title="背景图片">
                <StackPanel Margin="25,40,25,20">
                    <Grid x:Name="PanBackgroundSuit" Height="28" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="自适应方式" Margin="0,0,25,0" />
                        <local:MyComboBox local:SettingService.Key="UiBackgroundSuit" Grid.Column="1">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="自动"
                                                  ToolTip="图片较小时平铺，较大时居中并保持长宽比" />
                            <local:MyComboBoxItem local:SettingService.Value="4" Content="平铺" />
                            <local:MyComboBoxItem local:SettingService.Value="1" Content="居中" />
                            <local:MyComboBoxItem local:SettingService.Value="3" Content="拉伸" />
                            <local:MyComboBoxItem local:SettingService.Value="5" Content="左上（保持长宽比）" />
                            <local:MyComboBoxItem local:SettingService.Value="9" Content="左中（保持长宽比）" />
                            <local:MyComboBoxItem local:SettingService.Value="7" Content="左下（保持长宽比）" />
                            <local:MyComboBoxItem local:SettingService.Value="11" Content="中上（保持长宽比）" />
                            <local:MyComboBoxItem local:SettingService.Value="2" Content="居中（保持长宽比）" />
                            <local:MyComboBoxItem local:SettingService.Value="12" Content="中下（保持长宽比）" />
                            <local:MyComboBoxItem local:SettingService.Value="6" Content="右上（保持长宽比）" />
                            <local:MyComboBoxItem local:SettingService.Value="10" Content="右中（保持长宽比）" />
                            <local:MyComboBoxItem local:SettingService.Value="8" Content="右下（保持长宽比）" />
                        </local:MyComboBox>
                    </Grid>
                    <Grid x:Name="PanBackgroundOpacity" Height="22" Margin="0,0,0,7" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="不透明度" Margin="0,0,25,0" />
                        <local:MySlider local:SettingService.Key="UiBackgroundOpacity"
                                        x:Name="SliderBackgroundOpacity"
                                        MaxValue="1000" ValueByKey="10" Grid.Column="1" />
                    </Grid>
                    <Grid x:Name="PanBackgroundBlur" Height="22" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="背景模糊" Margin="0,0,25,0" />
                        <local:MySlider local:SettingService.Key="UiBackgroundBlur"
                                        x:Name="SliderBackgroundBlur"
                                        MaxValue="40" Grid.Column="1"
                                        ToolTip="高模糊会降低界面帧率，低性能设备建议关闭。" />
                    </Grid>
                    <local:MyCheckBox local:SettingService.Key="UiBackgroundColorful"
                                      Text="叠加彩色背景" Margin="-1,0,0,8" Height="22" />
                    <Grid Height="35" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnBackgroundOpen" MinWidth="140"
                                        Text="打开文件夹" Padding="13,0"
                                        Margin="0,0,20,0"
                                        ToolTip="将背景图片放入该文件夹，启动器每次打开时会随机加载一张" />
                        <local:MyButton x:Name="BtnBackgroundRefresh" MinWidth="140"
                                        Text="刷新背景图片" Padding="13,0"
                                        Margin="0,0,20,0" Grid.Column="1"
                                        ToolTip="随机切换到文件夹中的另一张背景图片" />
                        <local:MyButton x:Name="BtnBackgroundClear" MinWidth="140"
                                        Text="清空背景图片" Visibility="Collapsed"
                                        Padding="13,0" Margin="0,0,20,0"
                                        Grid.Column="2" ColorType="Red" />
                    </Grid>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="玩家战绩显示">
                <StackPanel Margin="25,38,23,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="游玩时长单位" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ColorBrush1}" />
                        <local:MyComboBox Grid.Column="1" Height="32"
                                          local:SettingService.Key="UiStatsPlayTimeFormat">
                            <local:MyComboBoxItem Content="天 + 小时"
                                                  local:SettingService.Value="0" />
                            <local:MyComboBoxItem Content="仅小时"
                                                  local:SettingService.Value="1" />
                        </local:MyComboBox>
                    </Grid>
                    <TextBlock Text="例如“20 天 3 小时”或“483 小时”。"
                               Margin="150,8,0,0" FontSize="11.5"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardMusic" Margin="0,0,0,15" Title="背景音乐">
                <StackPanel Margin="25,38,25,20">
                    <TextBlock Text="默认音乐由战雷提取"
                               TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                    <local:MyCheckBox x:Name="CheckMusicWarThunder"
                                      local:SettingService.Key="UiMusicWarThunder"
                                      Text="允许读取本机战争雷霆音乐" Margin="0,12,0,8" Height="22" />
                    <Grid x:Name="PanMusicVolume" Visibility="Collapsed" Height="22" Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="音量" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderMusicVolume"
                                        local:SettingService.Key="UiMusicVolume"
                                        MaxValue="1000" ValueByKey="10" Grid.Column="1" />
                    </Grid>
                    <StackPanel x:Name="PanMusicDetail" Visibility="Collapsed" Margin="0,0,0,8">
                        <local:MyCheckBox Text="随机播放" Margin="0,0,0,5" Height="22"
                                          x:Name="CheckMusicRandom"
                                          local:SettingService.Key="UiMusicRandom" />
                        <local:MyCheckBox Text="打开启动器自动开始播放" Margin="0,0,0,5" Height="22"
                                          x:Name="CheckMusicAuto"
                                          local:SettingService.Key="UiMusicAuto" />
                        <local:MyCheckBox Text="游戏启动后播放，游戏退出后暂停" Margin="0,0,0,5" Height="22"
                                          x:Name="CheckMusicStart"
                                          local:SettingService.Key="UiMusicStart" />
                        <local:MyCheckBox Text="游戏启动后暂停，游戏退出后播放" Margin="0,0,0,5" Height="22"
                                          x:Name="CheckMusicStop"
                                          local:SettingService.Key="UiMusicStop" />
                    </StackPanel>
                    <WrapPanel>
                        <local:MyButton x:Name="BtnMusicImportWarThunder"
                                        Text="提取战雷音乐" MinWidth="135"
                                        Height="35" Padding="13,0" Margin="0,5,12,0"
                                        ColorType="Highlight" />
                        <local:MyButton x:Name="BtnMusicOpen" Text="打开音乐目录"
                                        MinWidth="135" Height="35" Padding="13,0"
                                        Margin="0,5,12,0" />
                        <local:MyButton x:Name="BtnMusicRefresh" Text="刷新播放列表"
                                        MinWidth="135" Height="35" Padding="13,0"
                                        Margin="0,5,12,0" />
                        <local:MyButton x:Name="BtnMusicClear" Text="清空背景音乐"
                                        MinWidth="135" Height="35" Padding="13,0"
                                        Margin="0,5,12,0" Visibility="Collapsed" ColorType="Red" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
