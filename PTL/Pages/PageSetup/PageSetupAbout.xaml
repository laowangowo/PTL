<local:MyPageRight x:Class="PageSetupAbout"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PTL"
                   PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          x:Name="PanBack">
        <StackPanel Margin="25,25,25,10">
            <local:MyCard Title="关于">
                <StackPanel Margin="25,38,23,18">
                    <TextBlock x:Name="LabAboutVersion"
                               Text="Pain Thunder Launcher"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ColorBrush3}" />
                    <TextBlock Text="功能更丰富的战雷启动器"
                               Margin="0,7,0,0"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock Text="PTL 是社区项目，与 Gaijin Entertainment官方无隶属关系。"
                               Margin="0,7,0,0"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Title="开发与鸣谢" Margin="0,15,0,0">
                <Grid Margin="25,38,23,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58" />
                        <RowDefinition Height="58" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <Image Source="/PTL;component/Images/Heads/LTCat.jpg"
                           Width="34" Height="34" Margin="3">
                        <Image.Clip>
                            <EllipseGeometry Center="17,17" RadiusX="17" RadiusY="17" />
                        </Image.Clip>
                    </Image>
                    <local:MyListItem Title="龙腾猫跃"
                                      Info="Plain Craft Launcher / PCL2 作者"
                                      Margin="-5,0,15,0"
                                      IsHitTestVisible="False"
                                      Grid.Row="0" Grid.Column="1" />
                    <local:MyButton Text="爱发电"
                                    Width="130" Height="35"
                                    Grid.Row="0" Grid.Column="2"
                                    local:CustomEventService.EventType="打开网页"
                                    local:CustomEventService.EventData="https://ifdian.net/a/LTcat" />
                    <Grid Grid.Row="1">
                        <Border Width="34" Height="34" Margin="3"
                                CornerRadius="17"
                                Background="{DynamicResource ColorBrush3}">
                            <TextBlock Text="LW"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                        </Border>
                        <Image x:Name="ImgLaowangAvatar"
                               Source="/PTL;component/Images/Heads/laowangowo.avif"
                               Width="34" Height="34" Margin="3"
                               Stretch="UniformToFill"
                               ImageFailed="ImgLaowangAvatar_ImageFailed">
                            <Image.Clip>
                                <EllipseGeometry Center="17,17"
                                                 RadiusX="17"
                                                 RadiusY="17" />
                            </Image.Clip>
                        </Image>
                    </Grid>
                    <local:MyListItem Title="laowangowo"
                                      Info="PTL 开发者"
                                      Margin="-5,0,15,0"
                                      IsHitTestVisible="False"
                                      Grid.Row="1" Grid.Column="1" />
                    <local:MyButton Text="哔哩哔哩"
                                    Width="130" Height="35"
                                    Grid.Row="1" Grid.Column="2"
                                    local:CustomEventService.EventType="打开网页"
                                    local:CustomEventService.EventData="https://space.bilibili.com/1587980452" />
                </Grid>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
