<Grid x:Class="MyWarThunderResourceItem"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PTL"
      Height="76" Margin="0,0,0,7" Background="Transparent"
      Cursor="Hand" SnapsToDevicePixels="True">
    <Border x:Name="RowBackground" CornerRadius="5"
            Background="{DynamicResource ColorBrushSemiTransparent}"
            BorderBrush="Transparent" BorderThickness="1" />
    <Grid Margin="12,8,12,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="52" Height="52" CornerRadius="5" VerticalAlignment="Center"
                Background="{DynamicResource ColorBrushGray1}" ClipToBounds="True">
            <local:MyImage x:Name="ImgPreview" Stretch="UniformToFill"
                           FallbackSource="/PTL;component/Images/Icons/NoIcon.png"
                           RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <Grid Grid.Column="2" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LabTitle" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush1}"
                           TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" Margin="8,0,0,0" Padding="5,1"
                        CornerRadius="3"
                        Background="{DynamicResource ColorBrushSemiTransparent}">
                    <TextBlock Text="WT Live" FontSize="10.5"
                               Foreground="{DynamicResource ColorBrushGray2}" />
                </Border>
            </Grid>
            <TextBlock x:Name="LabDescription" Grid.Row="1" Margin="0,4,12,0"
                       FontSize="11.5" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource ColorBrushGray2}" />
            <TextBlock x:Name="LabMeta" Grid.Row="2" Margin="0,5,12,0"
                       FontSize="11" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource ColorBrushGray3}" />
        </Grid>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <local:MyButton x:Name="BtnPost" Text="查看" Width="54" Height="31"
                            Margin="0,0,7,0" />
            <local:MyButton x:Name="BtnInstall" Text="安装" Width="62" Height="31"
                            ColorType="Highlight" />
        </StackPanel>
    </Grid>
</Grid>
